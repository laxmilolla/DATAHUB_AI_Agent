# LLM Provider Configuration (choose one)
# Option 1: FREE - Groq (cloud, no local resources, very fast) - BEST FOR SLOW COMPUTERS
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Option 2: FREE - Ollama (local, uses CPU/RAM) - GOOD IF YOU HAVE GOOD COMPUTER
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:1b  # Use smallest model (1b) for slow computers

# Option 2: AWS Bedrock (requires AWS account)
# LLM_PROVIDER=bedrock
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
# AWS_DEFAULT_REGION=us-east-1
# BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# Option 3: OpenAI (requires API key)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-4-turbo-preview

# Option 4: Anthropic Direct API (requires API key)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Flask Configuration
FLASK_SECRET_KEY=your-secret-key-here
FLASK_ENV=development


